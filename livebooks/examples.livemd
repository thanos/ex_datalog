  |> Program.add_fact("manages", [:ceo, :vp_eng])
  |> Program.add_fact("manages", [:vp_eng, :eng_manager])
  |> Program.add_fact("manages", [:eng_manager, :alice])
  |> Program.add_fact("manages", [:eng_manager, :bob])
  |> ExDatalog.materialize()

```

